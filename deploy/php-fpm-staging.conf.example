; Example for a dedicated staging PHP-FPM pool. Install outside the webroot.
; Replace placeholders on the host; keep the real config readable only by root.
[iconiconline-staging]
user = iconic-staging
group = www-data
listen = /run/php/iconiconline-staging.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 4

clear_env = yes
security.limit_extensions = .php

; Use new, deployment-specific credentials for an isolated staging database.
env[ICONIC_DB_HOST] = "127.0.0.1"
env[ICONIC_DB_PORT] = "3306"
env[ICONIC_DB_NAME] = "REPLACE_ON_HOST"
env[ICONIC_DB_USER] = "REPLACE_ON_HOST"
env[ICONIC_DB_PASSWORD] = "REPLACE_ON_HOST"

php_admin_flag[cgi.fix_pathinfo] = off
php_admin_flag[allow_url_fopen] = off
php_admin_flag[display_errors] = off
php_admin_flag[display_startup_errors] = off
php_admin_flag[log_errors] = on
php_admin_flag[session.use_strict_mode] = on
php_admin_flag[session.cookie_secure] = on
php_admin_flag[session.cookie_httponly] = on
php_admin_value[session.cookie_samesite] = Strict
php_admin_value[session.save_path] = /srv/iconiconline/staging/sessions
php_admin_value[upload_max_filesize] = 5M
php_admin_value[post_max_size] = 6M
